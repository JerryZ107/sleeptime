<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="30dp"
        android:paddingEnd="18dp"
        android:paddingBottom="44dp">

        <!-- ================= 顶部 ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/app_name"
            android:textColor="@color/neon_cyan"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/brand_sub"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- ================= 状态 ================= -->
        <LinearLayout style="@style/Card" android:layout_marginTop="20dp">

            <TextView style="@style/SecTitle" android:text="@string/sec_status" />

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/neon_magenta"
                android:textSize="14sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvLockState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ================= 每日锁定时间 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_time" />

            <LinearLayout style="@style/Row">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:text="23:30"
                    android:textColor="@color/neon_cyan"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPickTime"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_pick_time" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@color/line" />

            <LinearLayout style="@style/Row">

                <TextView
                    android:id="@+id/tvUnlockTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:text="07:00"
                    android:textColor="@color/neon_magenta"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPickUnlock"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_pick_time" />
            </LinearLayout>

            <TextView
                style="@style/Sub"
                android:text="到点自动解除锁定。可以比锁定时刻小，表示跨午夜（例如 23:30 → 07:00）" />

            <TextView
                android:id="@+id/tvNextAlarm"
                style="@style/Sub" />
        </LinearLayout>

        <!-- ================= 锁定行为 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_switch" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sw_enabled"
                android:textColor="@color/text"
                android:textSize="15sp"
                app:trackTint="@color/neon_cyan"
                app:thumbTint="@color/neon_cyan" />

            <TextView style="@style/Sub" android:text="@string/sw_enabled_sub" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@color/line" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swPinTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sw_pin"
                android:textColor="@color/text"
                android:textSize="15sp"
                app:trackTint="@color/neon_cyan"
                app:thumbTint="@color/neon_cyan" />

            <TextView style="@style/Sub" android:text="@string/sw_pin_sub" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAllowCalls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sw_calls"
                android:textColor="@color/text"
                android:textSize="15sp"
                app:trackTint="@color/neon_cyan"
                app:thumbTint="@color/neon_cyan" />

            <TextView style="@style/Sub" android:text="@string/sw_calls_sub" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swKeepScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sw_keep_screen"
                android:textColor="@color/text"
                android:textSize="15sp"
                app:trackTint="@color/neon_cyan"
                app:thumbTint="@color/neon_cyan" />

            <TextView style="@style/Sub" android:text="@string/sw_keep_screen_sub" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swTurnScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sw_turn_screen"
                android:textColor="@color/text"
                android:textSize="15sp"
                app:trackTint="@color/neon_cyan"
                app:thumbTint="@color/neon_cyan" />

            <TextView style="@style/Sub" android:text="@string/sw_turn_screen_sub" />
        </LinearLayout>

        <!-- ================= 解锁难度 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_hold" />

            <LinearLayout style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neon_magenta"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="手指按住黑屏不放，抬手即重新计时 · 无进度提示"
                        android:textColor="@color/text_dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnPickHold"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_pick_hold" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================= 字体 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_font" />

            <TextView
                android:id="@+id/tvFontPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="SleepTime"
                android:textColor="@color/neon_cyan"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFontName"
                style="@style/Sub"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPickFont"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_pick_font" />

                <TextView
                    android:id="@+id/btnResetFont"
                    style="@style/Btn.Ghost"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_reset_font" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 权限自检 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_perm" />

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="悬浮窗（必须）" />

                    <TextView
                        android:id="@+id/tvOverlayState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOverlay"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="精确闹钟（必须）" />

                    <TextView
                        android:id="@+id/tvAlarmState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAlarm"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="通知 / 全屏提醒（建议）" />

                    <TextView
                        android:id="@+id/tvNotiState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnNoti"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="电话权限（来电解麦用）" />

                    <TextView
                        android:id="@+id/tvPhoneState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnPhone"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="勿扰权限（免打扰用）" />

                    <TextView
                        android:id="@+id/tvDndState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnDnd"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <!-- 1. 自启动 -->
            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="自启动（设置-应用-自启动）" />

                    <TextView
                        android:id="@+id/tvBootState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBoot"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_direct" />
            </LinearLayout>

            <!-- 2. 后台运行 / 允许完全后台行为 -->
            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="耗电管理（应用详情-耗电管理）" />

                    <TextView
                        android:id="@+id/tvBgState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBg"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_direct" />
            </LinearLayout>


            <LinearLayout style="@style/PermissionRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="电池优化白名单（建议）" />

                    <TextView
                        android:id="@+id/tvBatteryState"
                        style="@style/Sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBattery"
                    style="@style/Btn.Ghost"
                    android:text="@string/btn_fix" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 诊断日志 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="诊断日志" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swTrace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="记录诊断日志"
                android:textColor="@color/text"
                android:textSize="15sp"
                app:trackTint="@color/neon_cyan"
                app:thumbTint="@color/neon_cyan" />

            <TextView
                android:id="@+id/tvTraceInfo"
                style="@style/Sub" />

            <TextView
                android:id="@+id/btnClearTrace"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="清空日志" />
        </LinearLayout>

        <!-- ================= 操作 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_action" />

            <TextView
                android:id="@+id/btnTest"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="@string/btn_test" />

            <TextView
                android:id="@+id/btnStopTonight"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/btn_stop_tonight" />

            <TextView
                android:id="@+id/btnUninstall"
                style="@style/Btn.Danger"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/btn_uninstall" />
        </LinearLayout>

        <!-- ================= 说明 ================= -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/SecTitle" android:text="@string/sec_help" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/help"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>