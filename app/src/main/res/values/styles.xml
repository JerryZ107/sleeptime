<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 卡片 -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- 卡片内的横向行 -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SecTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Sub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- 伪按钮：用 TextView 画，避开各家 ROM 对 Button 的强制着色 -->
    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FF04141A</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Btn.Ghost">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="PermissionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>
</resources>